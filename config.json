{
  "data": {
    "train_dir": "Training",
    "test_dir": "Testing",
    "img_size": 128,
    "num_classes": 4
  },
  "model": {
    "name": "TumorCNN_Research",
    "backbone": "ResNet50_ImageNet",
    "description": "ImageNet-pretrained ResNet50 with a regularized research classification head"
  },
  "training": {
    "epochs": 80,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "dropout_rate": 0.5,
    "num_workers": 8,
    "pin_memory": true
  },
  "optimizer": {
    "type": "Adam",
    "betas": [0.9, 0.999],
    "weight_decay": 1e-5
  },
  "scheduler": {
    "type": "ReduceLROnPlateau",
    "mode": "max",
    "factor": 0.5,
    "patience": 5
  },
  "augmentation": {
    "rotation_degrees": 15,
    "brightness_jitter": 0.2,
    "contrast_jitter": 0.2,
    "horizontal_flip": true
  },
  "device": "auto",
  "seed": 42,
  "output_dir": "models"
}
